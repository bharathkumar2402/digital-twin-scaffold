# Local development only (Vite loads this for `npm run dev`, never for a production build).
# These are the fixed, demo-only values created by backend/scripts/seed_demo.py - not secrets.
# They make the login page offer a one-click "Use demo account" button. Delete this file or
# these lines to get the plain login form.
VITE_DEMO_TENANT_ID=d3500000-0000-4000-8000-000000000001
VITE_DEMO_EMAIL=demo@twinlabs.com
VITE_DEMO_PASSWORD=demo-password-123
