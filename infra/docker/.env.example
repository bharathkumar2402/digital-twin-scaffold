# Copy to infra/docker/.env and fill in real values. Never commit .env.

# Managed PostgreSQL (tenants, users, facilities, asset metadata)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Non-superuser role the app connects as at runtime (RLS-enforced, see migration 0002).
# POSTGRES_USER above stays reserved for running migrations only.
APP_DB_USER=app_role
APP_DB_PASSWORD=

# Managed TimescaleDB (telemetry hypertables) - separate instance from Postgres above
TIMESCALE_HOST=
TIMESCALE_PORT=5432
TIMESCALE_DB=
TIMESCALE_USER=
TIMESCALE_PASSWORD=

# Managed Redis (Celery broker, pub/sub for WebSocket delivery)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude API (agent layer)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# MinIO (floor plan tiles, model artifacts) - local container in docker-compose.yml
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Sentry
SENTRY_DSN=
