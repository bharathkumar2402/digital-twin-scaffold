# Copy to infra/docker/.env and fill in real values. Never commit .env.

# Managed PostgreSQL (tenants, users, facilities, asset metadata)
# On Supabase specifically: use the Session pooler host/port/user from
# Dashboard > Connect > Direct > Session pooler, NOT the direct db.<ref>.supabase.co
# host - that host only resolves over IPv6, which many networks can't route to
# ("getaddrinfo failed" on connect). Session pooler is IPv4-proxied and behaves like a
# direct connection. Its username is the compound "postgres.<project-ref>" form, not
# plain "postgres" - Supavisor (the pooler) requires that for every role.
# Passwords/usernames with special characters (e.g. "@") are handled automatically -
# app/core/config.py builds connection URLs with sqlalchemy.engine.URL.create, which
# percent-encodes them, so paste real values here unescaped.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Non-superuser role the app connects as at runtime (RLS-enforced, see migration 0002).
# POSTGRES_USER above stays reserved for running migrations only. If going through the
# Session pooler, this also needs the compound form: "app_role.<project-ref>" (the role
# itself is still named plain "app_role" in Postgres - only the connection-string
# username needs the suffix).
APP_DB_USER=app_role
APP_DB_PASSWORD=

# Managed TimescaleDB (telemetry hypertables) - separate instance from Postgres above,
# with its own migration chain (migrations_timescale/) and its own app_role.
TIMESCALE_HOST=
TIMESCALE_PORT=5432
TIMESCALE_DB=
TIMESCALE_USER=
TIMESCALE_PASSWORD=

# Non-superuser role the app connects as at runtime for sensor_readings (RLS-enforced,
# see migrations_timescale/versions/0001). TIMESCALE_USER above stays reserved for
# running migrations only. Roles are per-cluster, so this is a different role from
# APP_DB_USER above even if you reuse the same name/password.
#
# Note if you ever query sensor_readings directly as TIMESCALE_USER (e.g. Timescale
# Cloud's "tsdbadmin"): unlike Supabase's "postgres" role, it does NOT have BYPASSRLS,
# so a session that hasn't SET the app.current_tenant_id GUC will silently see zero
# rows (fail-closed, same as the app itself) rather than everything.
APP_TIMESCALE_USER=app_role
APP_TIMESCALE_PASSWORD=

# Managed Redis (Celery broker, pub/sub for WebSocket delivery)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude API (agent layer)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# MinIO (floor plan tiles, model artifacts) - local container in docker-compose.yml
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# In-Docker-network address the api/celery-worker containers use to reach minio - NOT
# localhost:9000, which only resolves from the host machine. Match app/sandbox's
# .env.sandbox.example (same instance, same "minio:9000" address).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Host-facing address used to build tile URLs returned to a browser (issue 2.4) -
# deliberately different from MINIO_ENDPOINT above. Defaults to localhost:9000 if unset.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# Sentry
SENTRY_DSN=
