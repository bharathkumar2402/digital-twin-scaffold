# Environment for the LOCAL demo stack (docker-compose.demo.yml). Demo-only values, safe to
# commit. Load into your shell before running anything from backend/ (see docs/DEMO.md):
#   PowerShell:  Get-Content ..\infra\docker\demo.env.example | Where-Object { $_ -match '^[A-Z_]+=' } |
#                  ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
#   bash:        set -a; source ../infra/docker/demo.env.example; set +a

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=digital_twin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=demo-admin-pass
APP_DB_USER=app_role
APP_DB_PASSWORD=demo-app-role-pass

TIMESCALE_HOST=localhost
TIMESCALE_PORT=5434
TIMESCALE_DB=digital_twin_telemetry
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=demo-admin-pass
APP_TIMESCALE_USER=app_role
APP_TIMESCALE_PASSWORD=demo-timescale-role-pass

REDIS_HOST=localhost
REDIS_PORT=6380

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

JWT_SECRET_KEY=demo-only-secret
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Score vibration waveforms during risk scoring and in the Maintenance agent.
VIBRATION_ENABLED=true
