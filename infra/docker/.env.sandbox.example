# Copy to infra/docker/.env.sandbox and fill in real values. Never commit .env.sandbox.
#
# This is the ONLY env file the `upload-sandbox` service loads (see docker-compose.yml).
# It deliberately does NOT include POSTGRES_*/TIMESCALE_*/APP_DB_*/JWT_* from the main
# .env — the sandbox worker (app/sandbox/**) processes untrusted floor-plan uploads and
# must have no DB credentials in its environment at all, so a compromised parser has
# nothing to exfiltrate or connect with beyond this narrow queue + object store access.

# Same physical Redis as the main app (Celery broker) - the sandbox worker only ever
# consumes the "upload-sandbox" queue and sends onto "sandbox-results" by task name, it
# never touches any other queue.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Same MinIO instance as the main app - the sandbox worker only reads from the raw
# uploads bucket, it never needs write access to any other bucket.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
